generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WaitlistEntry {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  phoneNumber String?
  role        String
  location    String
  trade       String?
  source      String?  @default("waitlist")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
